FOURBYTES_POSTGRES_HOST="localhost"
FOURBYTES_POSTGRES_DB="sourcify"
FOURBYTES_POSTGRES_USER="sourcify"
FOURBYTES_POSTGRES_PASSWORD="sourcify"
FOURBYTES_POSTGRES_PORT=5432
FOURBYTES_POSTGRES_MAX_CONNECTIONS=20
FOURBYTES_POSTGRES_SCHEMA="public"
PORT=4444
NODE_ENV=development # production for JSON logging
# Optional. URL of the hourly signature counts from BigQuery (bigquery/signature-stats-base.sql).
# Without it, /stats gives only the total. gs://bucket/object works on Google Cloud
# (it uses the service account of the service). https:// works anywhere.
SIGNATURE_STATS_BASE_URL=
